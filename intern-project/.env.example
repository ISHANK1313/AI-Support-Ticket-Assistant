# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
# Defaults checked against the published Gemini API documentation on 2026-09-19:
# gemini-3.5-flash-lite is a stable model with structured-output support, and
# gemini-embedding-001 supports the RETRIEVAL_DOCUMENT / RETRIEVAL_QUERY task types.
# Availability is account- and date-dependent, so use an identifier your account can use.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
DATABASE_PATH=ticket_assistant.db
KNOWLEDGE_BASE_PATH=knowledge_base
API_BASE_URL=http://127.0.0.1:8000
